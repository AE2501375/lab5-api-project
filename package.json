{
  "name": "fixmyunit-backend",
  "version": "1.0.0",
  "description": "FixMyUnit building maintenance tracker - Node.js/Express REST API (KH5041CMD Milestone 4)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node database/setup.js",
    "db:reset": "node database/setup.js --reset",
    "keys": "node scripts/generate-keys.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
