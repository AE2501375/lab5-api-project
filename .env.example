# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
HOST=localhost
PORT=5000

# Frontend origins allowed to call the API with cookies (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fixmyunit
DB_SSL=false

# Secrets - generate with: npm run keys
SESSION_SECRET=paste_output_of_npm_run_keys
DATA_ENCRYPTION_KEY=paste_64_hex_chars_from_npm_run_keys

# Session lifetime
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Brute-force protection
LOGIN_MAX_PER_MINUTE=5
LOCKOUT_FAILURES=5
LOCKOUT_MINUTES=15

# HTTPS (optional locally; run scripts/generate-cert.sh). Turns the cookie Secure flag on.
TLS_KEY_PATH=
TLS_CERT_PATH=
# Set to true when HTTPS is terminated by a proxy / cloud load balancer
COOKIE_SECURE=false
# Number of proxies in front of the app (0 locally, 1 behind a load balancer)
TRUST_PROXY=0

# First admin account, created by: npm run db:setup  (min 12 chars, letters + digits)
ADMIN_NAME=Building Manager
ADMIN_EMAIL=admin@fixmyunit.local
ADMIN_PASSWORD=change-me-to-your-own-long-passphrase-123
